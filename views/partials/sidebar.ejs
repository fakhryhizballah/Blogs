<aside class="space-y-6">
  <!-- Topics/Tags -->
  <div class="bg-white rounded-xl border border-ink-200 p-6">
    <h3 class="font-serif font-semibold text-ink-900 text-lg mb-4">Topik</h3>
    <% if (tags && tags.length > 0) { %>
      <div class="flex flex-wrap gap-2">
        <% tags.forEach(tag => { %>
          <a href="/topics/<%= tag._id %>"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm border transition
            <%= (typeof currentTag !== 'undefined' && currentTag === tag._id) ? 'bg-ink-900 text-white border-ink-900' : 'bg-ink-50 text-ink-700 border-ink-200 hover:border-ink-400 hover:bg-ink-100' %>">
            <span>#<%= tag._id %></span>
            <span class="text-xs opacity-60">(<%= tag.count %>)</span>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <p class="text-sm text-ink-400">Belum ada topik</p>
    <% } %>
  </div>

  <!-- Quick Search -->
  <div class="bg-white rounded-xl border border-ink-200 p-6">
    <h3 class="font-serif font-semibold text-ink-900 text-lg mb-4">Cari Artikel</h3>
    <form action="/search" method="GET">
      <div class="relative">
        <input type="text" name="q" placeholder="Ketik kata kunci..."
          class="w-full px-4 py-2.5 pr-10 bg-ink-50 border border-ink-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-accent-400 transition">
        <button type="submit" class="absolute right-3 top-1/2 -translate-y-1/2 text-ink-400 hover:text-accent-500">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </button>
      </div>
    </form>
  </div>
</aside>
