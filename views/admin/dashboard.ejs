<%- include('../partials/head') %>

<div class="flex min-h-screen bg-ink-50">
  <%- include('../partials/admin-sidebar', { user, currentPage }) %>

  <main class="flex-1 overflow-auto">
    <div class="px-6 py-8 max-w-5xl">
      <!-- Header -->
      <div class="mb-8">
        <h1 class="font-serif text-2xl font-bold text-ink-900">Selamat datang, <%= user.displayName %>! 👋</h1>
        <p class="text-ink-500 mt-1">Berikut ringkasan aktivitas blog Anda</p>
      </div>

      <!-- Flash messages -->
      <% if (flashSuccess) { %>
        <div class="mb-6 px-4 py-3 bg-green-50 border border-green-200 rounded-xl text-green-700 text-sm"><%= flashSuccess %></div>
      <% } %>

      <!-- Stats Cards -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-10">
        <div class="bg-white rounded-xl border border-ink-200 p-5 text-center">
          <p class="text-2xl font-bold text-ink-900 font-mono"><%= stats.total %></p>
          <p class="text-xs text-ink-500 mt-1">Total Artikel</p>
        </div>
        <div class="bg-white rounded-xl border border-ink-200 p-5 text-center">
          <p class="text-2xl font-bold text-green-600 font-mono"><%= stats.published %></p>
          <p class="text-xs text-ink-500 mt-1">Dipublikasi</p>
        </div>
        <div class="bg-white rounded-xl border border-ink-200 p-5 text-center">
          <p class="text-2xl font-bold text-yellow-600 font-mono"><%= stats.draft %></p>
          <p class="text-xs text-ink-500 mt-1">Draft</p>
        </div>
        <div class="bg-white rounded-xl border border-ink-200 p-5 text-center">
          <p class="text-2xl font-bold text-purple-600 font-mono"><%= stats.private %></p>
          <p class="text-xs text-ink-500 mt-1">Private</p>
        </div>
        <div class="bg-white rounded-xl border border-ink-200 p-5 text-center">
          <p class="text-2xl font-bold text-blue-600 font-mono"><%= stats.totalViews.toLocaleString() %></p>
          <p class="text-xs text-ink-500 mt-1">Total Views</p>
        </div>
        <div class="bg-white rounded-xl border border-ink-200 p-5 text-center">
          <p class="text-2xl font-bold text-accent-500 font-mono"><%= stats.totalComments %></p>
          <p class="text-xs text-ink-500 mt-1">Total Komentar</p>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="flex gap-3 mb-8">
        <a href="/admin/articles/new"
          class="flex items-center gap-2 px-5 py-2.5 bg-ink-900 text-white rounded-xl text-sm font-medium hover:bg-ink-800 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          Tulis Artikel Baru
        </a>
        <a href="/admin/articles"
          class="flex items-center gap-2 px-5 py-2.5 bg-white border border-ink-200 text-ink-700 rounded-xl text-sm font-medium hover:border-ink-400 transition">
          Semua Artikel
        </a>
      </div>

      <!-- Recent Articles -->
      <div class="bg-white rounded-xl border border-ink-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-ink-100 flex items-center justify-between">
          <h2 class="font-semibold text-ink-900">Artikel Terbaru</h2>
          <a href="/admin/articles" class="text-sm text-accent-500 hover:text-accent-600">Lihat semua →</a>
        </div>
        <% if (articles && articles.length > 0) { %>
          <div class="divide-y divide-ink-100">
            <% articles.forEach(article => { %>
              <div class="px-6 py-4 flex items-center gap-4 hover:bg-ink-50 transition">
                <div class="flex-1 min-w-0">
                  <p class="font-medium text-ink-900 text-sm truncate"><%= article.title %></p>
                  <p class="text-xs text-ink-400 mt-0.5">
                    <%= new Date(article.createdAt).toLocaleDateString('id-ID', {day:'numeric', month:'short', year:'numeric'}) %>
                    · <%= article.views %> views · <%= article.comments.length %> komentar
                  </p>
                </div>
                <div class="flex items-center gap-2 flex-shrink-0">
                  <span class="px-2.5 py-1 rounded-full text-xs font-medium
                    <%= article.status === 'published' ? 'bg-green-100 text-green-700' : article.status === 'draft' ? 'bg-yellow-100 text-yellow-700' : 'bg-purple-100 text-purple-700' %>">
                    <%= article.status === 'published' ? 'Publikasi' : article.status === 'draft' ? 'Draft' : 'Private' %>
                  </span>
                  <a href="/admin/articles/<%= article._id %>/edit"
                    class="p-1.5 text-ink-400 hover:text-ink-700 rounded hover:bg-ink-100 transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                  </a>
                  <% if (article.status === 'published') { %>
                    <a href="/articles/<%= article.slug %>" target="_blank"
                      class="p-1.5 text-ink-400 hover:text-accent-500 rounded hover:bg-ink-100 transition">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                    </a>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-center py-12 text-ink-400">
            <p class="text-sm">Belum ada artikel. <a href="/admin/articles/new" class="text-accent-500 hover:underline">Tulis sekarang</a></p>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</div>
</body>
</html>
