<%- include('../partials/head') %>

<div class="flex min-h-screen bg-ink-50">
  <%- include('../partials/admin-sidebar', { user, currentPage }) %>

  <main class="flex-1 overflow-auto">
    <div class="px-6 py-8 max-w-2xl">
      <h1 class="font-serif text-2xl font-bold text-ink-900 mb-6">Edit Profil</h1>

      <% if (flashError) { %>
        <div class="mb-6 px-4 py-3 bg-red-50 border border-red-200 rounded-xl text-red-700 text-sm"><%= flashError %></div>
      <% } %>
      <% if (flashSuccess) { %>
        <div class="mb-6 px-4 py-3 bg-green-50 border border-green-200 rounded-xl text-green-700 text-sm"><%= flashSuccess %></div>
      <% } %>

      <!-- Profile Card -->
      <div class="bg-white rounded-xl border border-ink-200 p-6 mb-6">
        <div class="flex items-start gap-6 mb-6 pb-6 border-b border-ink-100">
          <div class="relative">
            <img src="<%= user.avatar || '/images/default-avatar.png' %>" alt="<%= user.displayName %>"
              id="avatarPreview"
              class="w-20 h-20 rounded-full object-cover border-4 border-ink-200">
          </div>
          <div class="flex-1">
            <h2 class="font-serif text-xl font-semibold text-ink-900"><%= user.displayName %></h2>
            <p class="text-ink-500 text-sm">@<%= user.username %></p>
            <p class="text-ink-400 text-xs mt-1"><%= user.email %></p>
            <span class="mt-2 inline-block px-2.5 py-0.5 bg-accent-500/10 text-accent-600 rounded-full text-xs font-medium capitalize"><%= user.role %></span>
          </div>
        </div>

        <form action="/admin/profile" method="POST" class="space-y-5">
          <div>
            <label class="block text-sm font-medium text-ink-700 mb-1.5">Nama Tampil</label>
            <input type="text" name="displayName" value="<%= user.displayName %>" required
              class="w-full px-4 py-3 border border-ink-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-accent-400 transition">
          </div>
          <div>
            <label class="block text-sm font-medium text-ink-700 mb-1.5">URL Foto Profil</label>
            <div class="flex gap-2">
              <input type="text" name="avatar" id="avatarUrl" value="<%= user.avatar || '' %>"
                placeholder="https://example.com/photo.jpg"
                class="flex-1 px-4 py-3 border border-ink-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-accent-400 transition">
              <button type="button" onclick="previewAvatar()"
                class="px-4 py-3 bg-ink-100 text-ink-700 rounded-xl text-sm hover:bg-ink-200 transition">Preview</button>
            </div>
            <p class="text-xs text-ink-400 mt-1.5">Upload foto ke API, lalu paste URL-nya di sini</p>
          </div>
          <div>
            <label class="block text-sm font-medium text-ink-700 mb-1.5">Bio</label>
            <textarea name="bio" rows="3" placeholder="Ceritakan sedikit tentang dirimu..."
              class="w-full px-4 py-3 border border-ink-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-accent-400 resize-none transition"><%= user.bio || '' %></textarea>
          </div>
          <button type="submit"
            class="w-full py-3 bg-ink-900 text-white rounded-xl text-sm font-semibold hover:bg-ink-800 transition">
            Simpan Profil
          </button>
        </form>
      </div>

      <!-- Change Password -->
      <div class="bg-white rounded-xl border border-ink-200 p-6">
        <h2 class="font-semibold text-ink-900 mb-5">Ubah Password</h2>
        <form action="/admin/profile/password" method="POST" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-ink-700 mb-1.5">Password Lama</label>
            <input type="password" name="currentPassword" required placeholder="••••••••"
              class="w-full px-4 py-3 border border-ink-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-accent-400 transition">
          </div>
          <div>
            <label class="block text-sm font-medium text-ink-700 mb-1.5">Password Baru</label>
            <input type="password" name="newPassword" required placeholder="Min. 6 karakter"
              class="w-full px-4 py-3 border border-ink-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-accent-400 transition">
          </div>
          <button type="submit"
            class="w-full py-3 bg-red-600 text-white rounded-xl text-sm font-semibold hover:bg-red-700 transition">
            Ubah Password
          </button>
        </form>
      </div>
    </div>
  </main>
</div>

<script>
  function previewAvatar() {
    const url = document.getElementById('avatarUrl').value;
    if (url) document.getElementById('avatarPreview').src = url;
  }
  document.getElementById('avatarUrl').addEventListener('input', function() {
    if (this.value) previewAvatar();
  });
</script>
</body>
</html>
