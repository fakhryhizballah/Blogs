<%- include('../partials/head') %>

<div class="min-h-screen bg-ink-900 flex items-center justify-center p-4">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <div class="inline-flex items-center gap-3 mb-4">
        <div class="w-12 h-12 bg-accent-500 rounded-xl flex items-center justify-center">
          <span class="text-white font-serif font-bold text-xl">EA</span>
        </div>
        <span class="font-serif font-bold text-white text-2xl">Everything & Anything</span>
      </div>
      <p class="text-ink-400">Masuk ke Panel Admin</p>
    </div>

    <% if (flashError) { %>
      <div class="mb-6 px-4 py-3 bg-red-900/40 border border-red-500/30 rounded-xl text-red-300 text-sm flex items-center gap-2">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <%= flashError %>
      </div>
    <% } %>
    <% if (flashSuccess) { %>
      <div class="mb-6 px-4 py-3 bg-green-900/40 border border-green-500/30 rounded-xl text-green-300 text-sm"><%= flashSuccess %></div>
    <% } %>

    <div class="bg-ink-800 rounded-2xl p-8 border border-ink-700">
      <!-- JWT Info Badge -->
      <div class="flex items-center gap-2 mb-6 px-3 py-2 bg-ink-900/60 rounded-lg border border-ink-600/50">
        <svg class="w-4 h-4 text-accent-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        <span class="text-xs text-ink-400">Sesi diamankan dengan <span class="text-accent-400 font-medium">JSON Web Token</span></span>
      </div>

      <form action="/admin/login" method="POST" class="space-y-5">
        <div>
          <label class="block text-sm font-medium text-ink-300 mb-1.5">Username atau Email</label>
          <input type="text" name="username" required placeholder="username atau email"
            class="w-full px-4 py-3 bg-ink-900 border border-ink-600 rounded-xl text-white placeholder-ink-500 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-transparent transition text-sm">
        </div>
        <div>
          <label class="block text-sm font-medium text-ink-300 mb-1.5">Password</label>
          <input type="password" name="password" required placeholder="••••••••"
            class="w-full px-4 py-3 bg-ink-900 border border-ink-600 rounded-xl text-white placeholder-ink-500 focus:outline-none focus:ring-2 focus:ring-accent-500 focus:border-transparent transition text-sm">
        </div>
        <button type="submit"
          class="w-full py-3 bg-accent-500 text-white rounded-xl font-semibold hover:bg-accent-600 transition text-sm">
          Masuk
        </button>
      </form>

      <div class="mt-6 text-center text-sm text-ink-500">
        Belum punya akun?
        <a href="/admin/register" class="text-accent-400 hover:text-accent-300 font-medium ml-1">Daftar di sini</a>
      </div>
    </div>

    <div class="text-center mt-6">
      <a href="/" class="text-sm text-ink-500 hover:text-ink-300 transition">← Kembali ke Blog</a>
    </div>
  </div>
</div>
</body>
</html>
