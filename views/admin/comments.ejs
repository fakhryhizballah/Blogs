<%- include('../partials/head') %>

<div class="flex min-h-screen bg-ink-50">
  <%- include('../partials/admin-sidebar', { user, currentPage }) %>

  <main class="flex-1 overflow-auto">
    <div class="px-6 py-8 max-w-4xl">
      <h1 class="font-serif text-2xl font-bold text-ink-900 mb-6">Kelola Komentar</h1>

      <% if (articles && articles.length > 0) { %>
        <div class="space-y-6">
          <% articles.forEach(article => { %>
            <div class="bg-white rounded-xl border border-ink-200 overflow-hidden">
              <div class="px-6 py-4 bg-ink-50 border-b border-ink-200 flex items-center justify-between">
                <div>
                  <h2 class="font-semibold text-ink-800 text-sm"><%= article.title %></h2>
                  <p class="text-xs text-ink-400 mt-0.5"><%= article.comments.length %> komentar</p>
                </div>
                <a href="/articles/<%= article.slug %>" target="_blank"
                  class="text-xs text-accent-500 hover:text-accent-600">Lihat artikel →</a>
              </div>

              <div class="divide-y divide-ink-100">
                <% article.comments.slice().reverse().forEach(comment => { %>
                  <div class="px-6 py-4 flex items-start gap-4" id="admin-comment-<%= comment._id %>">
                    <div class="w-8 h-8 bg-ink-200 rounded-full flex items-center justify-center flex-shrink-0">
                      <span class="text-ink-600 font-medium text-xs"><%= comment.guestName.charAt(0).toUpperCase() %></span>
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-2 mb-1">
                        <span class="font-medium text-ink-800 text-sm"><%= comment.guestName %></span>
                        <span class="text-xs text-ink-400">·</span>
                        <span class="text-xs text-ink-400">
                          <%= new Date(comment.createdAt).toLocaleDateString('id-ID', {day:'numeric', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit'}) %>
                        </span>
                      </div>
                      <p class="text-ink-700 text-sm leading-relaxed"><%= comment.content %></p>
                    </div>
                    <button onclick="deleteAdminComment('<%= article._id %>', '<%= comment._id %>')"
                      class="flex-shrink-0 p-1.5 text-ink-300 hover:text-red-500 rounded hover:bg-red-50 transition"
                      title="Hapus komentar">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    </button>
                  </div>
                <% }) %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="text-center py-16 text-ink-400 bg-white rounded-xl border border-ink-200">
          <svg class="w-12 h-12 mx-auto mb-4 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
          <p>Belum ada komentar</p>
        </div>
      <% } %>
    </div>
  </main>
</div>

<script>
  async function deleteAdminComment(articleId, commentId) {
    if (!confirm('Hapus komentar ini?')) return;
    const res = await fetch(`/admin/articles/${articleId}/comments/${commentId}/delete`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    });
    const data = await res.json();
    if (data.success) {
      document.getElementById(`admin-comment-${commentId}`)?.remove();
    } else {
      alert('Gagal menghapus komentar');
    }
  }
</script>
</body>
</html>
